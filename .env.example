# Backend
RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_SCORE_THRESHOLD=0.28
RAG_CORS_ORIGINS=http://localhost:5173

# Local LLM with Ollama (default provider)
RAG_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Alternative OpenAI-compatible provider. Keep the real key only in .env.
# RAG_LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# Groq free API (recommended): RAG_LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=<your Groq key>

# Administration (televersement de documents, tableau de bord).
# Sans ADMIN_PASSWORD, l'administration est desactivee. AUTH_SECRET signe les jetons de session.
ADMIN_PASSWORD=
AUTH_SECRET=
# RAG_MAX_UPLOAD_MB=20
# RAG_REQUIRE_REVIEW=false
# RAG_CONTACT_EMAIL=scolarite@eih.ma
# RAG_CONTACT_PHONE=+212 5 22 00 00 00
